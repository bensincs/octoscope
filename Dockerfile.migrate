# ---------------------------------------------------------------------------
# Schema migrator — runs `drizzle-kit push` from INSIDE Azure.
#
# Why this exists: the app image (see Dockerfile) is a Next.js standalone build
# with no dev dependencies, so it cannot run drizzle-kit. Pushing from a laptop
# instead requires opening a Postgres firewall rule for your IP *and* outbound
# access on :5432, which corporate networks commonly block. Running the push as
# a Container Apps job in the same environment avoids both problems — the app
# environment already reaches Postgres via the AllowAllAzureServices rule.
#
# Build + run:  see infra/deploy.md, "Applying the database schema".
# ---------------------------------------------------------------------------
FROM node:20-alpine

WORKDIR /app

# drizzle-kit is a devDependency, so this image must NOT set NODE_ENV=production.
ENV NPM_CONFIG_UPDATE_NOTIFIER=false
ENV NEXT_TELEMETRY_DISABLED=1

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY drizzle.config.js ./
COPY lib ./lib
COPY scripts ./scripts

# DATABASE_URL is injected as a job secret. Default: push the schema, then list
# the resulting tables as a sanity check.
#
# push ALWAYS runs with --force, because without it drizzle-kit prompts, takes
# the default when stdin is closed, and exits 0 having applied nothing — a
# schema change that silently doesn't happen, reported as success.
#
# The data-loss guard is therefore ours: `preflight` compares the database with
# schema.js and refuses to continue if the change would drop a table or column,
# unless ALLOW_DATA_LOSS is set. `verify-schema` then asserts the change really
# landed, so a no-op push can never again be mistaken for a successful one.
#
# --verbose logs every statement, so Log Analytics keeps a record of what ran.
#
# Override for other operations, e.g. seeding the first super admin:
#   --command "node" --args "scripts/db-ops.cjs" "seed-admin" "<github-login>"
CMD ["sh", "-c", "node scripts/db-ops.cjs preflight && npx drizzle-kit push --force --verbose && node scripts/db-ops.cjs verify-schema && node scripts/db-ops.cjs tables"]
